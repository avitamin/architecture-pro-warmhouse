        },
        "value": {
          "$ref": "#/definitions/Value"
        },
        "measured_at": {
          "$ref": "#/definitions/Instant"
        },
        "gateway_received_at": {
          "$ref": "#/definitions/Instant"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "event_id",
        "device_id",
        "capability_id",
        "value",
        "measured_at",
        "gateway_received_at"
      ]
    },
    "TelemetryPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Measurement"
          }
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": [
