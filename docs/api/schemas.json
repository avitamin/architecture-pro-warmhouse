        "event_id",
        "type",
        "schema_version",
        "occurred_at",
        "poll_job_id",
        "device_id",
        "capability_id",
        "outcome"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "required": [
              "measurement_event_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "measurement_event_id"
              ]
            }
          }
        }
      ]
    },
