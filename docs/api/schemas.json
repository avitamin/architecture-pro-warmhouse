        },
        "target_capability_id": {
          "$ref": "#/definitions/Id"
        },
        "action_parameters": {
          "$ref": "#/definitions/Parameters"
        },
        "command_ttl_ms": {
          "$ref": "#/definitions/Millis"
        }
      },
      "required": [
        "name",
        "enabled",
        "input_device_id",
        "input_capability_id",
        "operator",
        "threshold",
        "max_data_age_ms",
