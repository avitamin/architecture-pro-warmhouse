{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Непрозрачный стабильный ID. Формат БД не задаётся."
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "RFC 3339, UTC с Z."
    },
    "Counter": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "Положительный счётчик, не более uint64; JSON-строка для сохранения точности."
    },
    "Version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "Millis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "Value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "Parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Value"
          }
        }
      },
      "required": [
        "operation",
        "arguments"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_ARGUMENT",
            "UNAUTHENTICATED",
            "PERMISSION_DENIED",
            "NOT_FOUND",
            "CONFLICT",
            "VALIDATION_FAILED",
            "UNAVAILABLE",
            "DEADLINE_EXCEEDED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "request_id": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ]
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "code": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "measurement",
            "control",
            "live_video"
          ]
        },
        "value_type": {
          "type": "string",
          "enum": [
            "number",
            "boolean",
            "text"
          ]
        },
        "unit": {
          "type": "string"
        },
        "parameters_schema": {
          "type": "object",
          "description": "JSON Schema draft-07 для Parameters; обязательна для control."
        }
      },
      "required": [
        "id",
        "code",
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "measurement"
              }
            }
          },
          "then": {
            "required": [
              "value_type"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "control"
              }
            }
          },
          "then": {
            "required": [
              "parameters_schema"
            ]
          }
        }
      ]
    },
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "house_id": {
          "$ref": "#/definitions/Id"
        },
        "type_id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "registration_status": {
          "type": "string",
          "enum": [
            "bound"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          }
        }
      },
      "required": [
        "id",
        "house_id",
        "type_id",
        "name",
        "registration_status",
        "capabilities"
      ]
    },
    "Measurement": {
      "type": "object",
