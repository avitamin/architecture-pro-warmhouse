        },
        "rule_version": {
          "$ref": "#/definitions/Version"
        },
        "trigger_id": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "command_id",
        "device_id",
        "capability_id",
        "user_id",
        "source",
        "parameters",
        "expires_at",
        "created_at",
