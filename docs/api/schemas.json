        },
        "config": {
          "$ref": "#/definitions/ConfigSnapshot"
        },
        "rule_id": {
          "$ref": "#/definitions/Id"
        },
        "rule_version": {
          "$ref": "#/definitions/Version"
        },
        "trigger_id": {
          "$ref": "#/definitions/Id"
        },
        "causation_event_id": {
          "$ref": "#/definitions/Id"
        },
        "manual_cancel_before_seq": {
          "$ref": "#/definitions/Counter"
        }
      },
      "required": [
        "event_id",
        "type",
        "schema_version",
        "occurred_at",
        "command_id",
        "device_id",
        "capability_id",
        "user_id",
        "source",
        "parameters",
        "acceptance_seq",
        "expires_at",
        "config"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "scenario"
              }
            }
          },
          "then": {
            "required": [
              "rule_id",
              "rule_version",
              "trigger_id",
              "causation_event_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "manual"
              }
            }
          },
          "then": {
            "required": [
              "manual_cancel_before_seq"
            ]
          }
        }
      ]
