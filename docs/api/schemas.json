          "enum": [
            "none",
            "operation_completed",
            "operation_failed",
            "not_executed"
          ]
        }
      },
      "required": [
        "event_id",
        "type",
        "schema_version",
        "occurred_at",
        "command_id",
        "device_id",
        "capability_id",
        "result_version",
        "status",
        "state_changed_at",
        "reason_code",
        "evidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "queued"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "const": "QUEUED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "sent"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "const": "SENT"
              }
            }
          }
        }
      ]
    }
  }
}
