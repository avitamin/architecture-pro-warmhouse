@startuml to-be-context
!pragma layout smetana
!include <C4/C4_Context>
LAYOUT_LEFT_RIGHT()
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam wrapWidth 190
title Умный дом — To-Be · C4 System Context
Person(owner, "Пользователь", "Самостоятельно подключает совместимое оборудование и управляет своим домом")
Person(engineer, "Разработчик / оператор", "Диагностирует работу платформы")
System(platform, "Платформа умного дома", "Устройства и права; история показаний; команды; правила; просмотр live-видео; эксплуатационная диагностика")
System_Ext(devices, "Совместимое оборудование", "Датчики и исполнительные устройства: отопление, освещение, ворота")
System_Ext(camera, "Совместимые камеры", "Партнёрские камеры с поддерживаемой сигнализацией и live-видео")
System_Ext(agent, "Агент-разработчик", "Внешний инструмент разработки; читает диагностические данные с ограниченными правами")
Rel(owner, platform, "Настраивает, управляет, читает показания и смотрит видео")
Rel(engineer, platform, "Читает диагностику")
Rel(agent, platform, "Запрашивает логи, метрики и трассы")
Rel(platform, devices, "Опросы и команды")
Rel(devices, platform, "Ответы и подтверждения; инициирует подключение")
Rel(platform, camera, "Организует сеанс просмотра")
Rel(camera, platform, "Сигнализация и live-видео в клиентское приложение")
note bottom of platform
  Веб-приложение и инфраструктура принадлежат платформе.
  Сервисы, БД, брокер и TURN раскрываются на уровне Containers.
  Архива видео нет. Конкретные партнёрские модели ещё проверяются.
end note
SHOW_LEGEND()

footer Проектируемая архитектура · код сервисов не реализован · детали контрактов уточняются
@enduml
